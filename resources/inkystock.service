[Unit]
Description=InkyStock e-ink ticker
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
# Accept the readiness/watchdog pings even if run.sh's fallback path forks Python
# (e.g. via `uv run`) rather than exec'ing it as the main PID.
NotifyAccess=all
User=__USER__
WorkingDirectory=__INSTALL_DIR__
# run.sh picks uv (or a .venv fallback) and execs the Python daemon, so the
# notify socket and watchdog are handled by the app itself.
ExecStart=__INSTALL_DIR__/run.sh --daemon
EnvironmentFile=-__INSTALL_DIR__/.env
Restart=on-failure
RestartSec=10
# The daemon pings the watchdog after each update and during its sleep, so a
# genuinely wedged update (despite the per-request timeouts) gets restarted.
WatchdogSec=120

[Install]
WantedBy=multi-user.target
